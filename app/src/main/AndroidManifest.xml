<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      REQ-107 / AD-11 / D3: nothing FastReader stores takes part in the device's
      own backup. allowBackup="false" covers cloud backup and restore on every
      supported API level; dataExtractionRules additionally excludes the
      device-to-device transfer that API 31+ performs regardless of that
      attribute, and fullBackupContent states the same exclusion in the API
      26-30 vocabulary. Proven on the emulator with the platform's backup
      manager, not by reading this file back (see docs/evidence/46/).
    -->
    <application
        android:name=".FastReaderApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastReader">
        <!--
            android:configChanges="uiMode" is load-bearing, not tidying. Changing
            the theme in Settings pushes an app-level night override so the
            *system splash* resolves the right way on the next cold start
            (AD-10) — and that is a configuration change, which without this
            attribute tears the activity down and rebuilds it in front of a
            reader who only tapped a radio button. Compose picks the new
            configuration up without recreation, and the window background the
            attribute freezes is only ever seen at launch, where it has just been
            set from the mirror.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
