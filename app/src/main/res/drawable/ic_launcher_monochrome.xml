<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon's monochrome layer (REQ-101).

    The same geometry as ic_launcher_foreground, flattened to one ink. The system
    replaces this fill with the themed-icon tint, so the shape has to survive
    without colour: that is why the recognition letter is drawn taller than the
    word instead of in the highlight colour.

    Kept as a separate file rather than reusing the foreground with a tint,
    because a themed icon and the full-colour icon are drawn by different code
    paths and a shared drawable would tie their fills together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The word, split around the letter the eye lands on. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M29,41 L41,41 A5,5 0 0 1 41,51 L29,51 A5,5 0 0 1 29,41 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M67,41 L79,41 A5,5 0 0 1 79,51 L67,51 A5,5 0 0 1 67,41 Z" />

    <!-- The recognition letter, standing proud of the word. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M52,35 L56,35 A3,3 0 0 1 59,38 L59,54 A3,3 0 0 1 56,57 L52,57 A3,3 0 0 1 49,54 L49,38 A3,3 0 0 1 52,35 Z" />

    <!-- The guide marks: a caret on the column the word lands on, over its rail. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M54,61 L49,67 L59,67 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M30,69 L78,69 A2,2 0 0 1 78,73 L30,73 A2,2 0 0 1 30,69 Z" />

</vector>
