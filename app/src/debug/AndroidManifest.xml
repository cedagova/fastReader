<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Debug builds only (#100, host requirement 3 of reader-auth/CONTRACT.md):
        a network security configuration that lets a debug build reach a
        server on the development machine through the emulator loopback
        (10.0.2.2) without TLS. The file it points at lives in this source set
        too, so neither the attribute nor the allowance exists in a release
        APK; scripts/release.sh dies if the release manifest carries one.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!--
            Debug-only host for the system document picker, used by the on-device
            Storage Access Framework test. It is absent from release builds.
        -->
        <activity
            android:name=".library.PickerHostActivity"
            android:exported="false" />
        <!--
            Debug-only crash button (REQ-207). `adb shell am start` runs as the
            shell user, which may only start an activity another uid has
            exported, so this one is exported and takes no data of any kind: it
            throws in onCreate and nothing else. It is absent from release
            builds, because this whole file is.
        -->
        <activity
            android:name=".debug.CrashInducerActivity"
            android:exported="true" />
    </application>

</manifest>
