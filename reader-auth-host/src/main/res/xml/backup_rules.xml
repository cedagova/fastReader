<?xml version="1.0" encoding="utf-8"?>
<!--
  The API 26-30 statement of the same exclusion as data_extraction_rules.xml.

  `android:allowBackup="false"` already stops every form of backup on those
  levels, so this changes nothing today. It exists so the exclusion is stated in
  both of the platform's vocabularies: should `allowBackup` ever be flipped by a
  merged library manifest or an edit that looks harmless, this file still keeps
  the host's data out of a pre-Android-12 backup. Every domain is listed for the
  reason given in the sibling file; this schema requires a `path`, and "." is
  the whole domain.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
