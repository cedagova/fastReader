<?xml version="1.0" encoding="utf-8"?>
<!--
  Whole-app exclusion from both halves of Android 12+ data extraction.

  `android:allowBackup="false"` in the manifest stops cloud backup and restore
  everywhere the host runs, and on API 26-30 it stops everything. From API 31 it
  does *not* stop device-to-device transfer: that path is governed only by this
  file. This host will hold authentication tokens on behalf of :reader-auth, and
  a token copied onto another phone by the setup wizard is a token that left the
  device.

  Every domain is listed, in both sections, because the domains do not nest:
  `root` is the app's data directory itself, and `files/`, `databases/` and
  `shared_prefs/` are the separate `file`, `database` and `sharedpref` domains
  (FastReader measured on an emulator that excluding `root` alone still handed
  the rest to the transport). The `device_*` domains are the same four in
  device-protected storage, and `external` is anything written outside the
  sandbox. Nothing is opted back in: an inclusion element anywhere fails
  HostManifestTest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
