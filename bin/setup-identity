#!/bin/sh
# One-time per-clone wiring so every guard in bin/ is actually active.
# This repository is always worked on as the GitHub account 'cedagova'.

set -eu

expected_account="cedagova"
# Resolve the MAIN clone, never a linked worktree. credential.helper lives in
# the shared .git/config, so a worktree-local path would break every push in
# every worktree (including the main clone) as soon as that worktree is removed.
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
repo_root="$(cd "$(dirname "$common_dir")" && pwd -P)"
helper="$repo_root/bin/git-credential-personal"
if [ ! -x "$helper" ]; then
  echo "Setup failed: credential helper '$helper' is not an executable file." >&2
  exit 1
fi

git -C "$repo_root" config core.hooksPath .githooks
git -C "$repo_root" config credential.useHttpPath true
git -C "$repo_root" config "credential.https://github.com.username" "$expected_account"

# Replace any inherited helper rather than stacking on top of it.
git -C "$repo_root" config --unset-all credential.helper || true
git -C "$repo_root" config --add credential.helper ""
git -C "$repo_root" config --add credential.helper "$helper"

active="$("$repo_root/bin/gh-personal" api user --jq .login)"
if [ "$active" != "$expected_account" ]; then
  echo "Setup failed: resolved GitHub account is '$active', expected '$expected_account'." >&2
  exit 1
fi

echo "Wired to GitHub account '$expected_account'. Hooks: .githooks. Helper: $helper"
